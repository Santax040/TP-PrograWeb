# Copiar a .env.local y completar. Los valores están en el panel de Supabase:
# Project Settings → API Keys. La clave "publishable" es pública por diseño;
# lo que protege los datos son los permisos (RLS) de la base.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Mail al admin cuando un lector manda una propuesta (/colabora). Secretas:
# sin NEXT_PUBLIC_, nunca llegan al navegador. Sin dominio propio, Resend solo
# deja mandar al mail con el que se creó la cuenta.
RESEND_API_KEY=re_...
AVISO_ENVIOS_PARA=tu-mail@gmail.com
