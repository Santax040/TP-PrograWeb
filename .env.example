# Copiar a .env.local y completar. Los valores están en el panel de Supabase:
# Project Settings → API Keys. La clave "publishable" es pública por diseño;
# lo que protege los datos son los permisos (RLS) de la base.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Mail al admin cuando un lector manda una propuesta (/colabora). Secretas:
# sin NEXT_PUBLIC_, nunca llegan al navegador. Sin dominio propio, Resend solo
# deja mandar al mail con el que se creó la cuenta.
RESEND_API_KEY=re_...
AVISO_ENVIOS_PARA=tu-mail@gmail.com

# Mercado Pago (Checkout Pro). Usar las de la pestaña "Credenciales de prueba".
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Para que los artistas conecten su Mercado Pago. Son de una aplicación creada
# con el modelo "Marketplace"; salen de sus detalles (Client ID y Client Secret).
# La Redirect URL registrada ahí tiene que ser <APP_URL>/api/mercadopago/conectar/vuelta.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# "true" mientras se prueba con usuarios de prueba de Mercado Pago.
MP_CUENTAS_DE_PRUEBA=
