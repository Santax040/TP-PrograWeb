# Copiar a supabase/.env (ignorado por git) y completar con las credenciales
# de Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth.
# Las usa `supabase config push` para activar el login con Google.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=GOCSPX-...
